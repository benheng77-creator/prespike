# claw247-trading .env template
#
# Single source of truth for all API keys and runtime secrets.
# Managed via the Operator center (https://claw247-trading.pages.dev/ops/)
# when OPS_ADMIN_TOKEN is set — but direct editing of this file is also
# fine. The file lives on the trader host only; the browser and the
# Cloudflare Worker never see raw values.
#
# Copy:   cp .env.example .env
# Lock:   chmod 600 .env   (enforced automatically when Ops UI writes)
#
# Precedence: process env > .env > hard-coded defaults.

# -----------------------------------------------------------------------------
# 0. Operator admin
# -----------------------------------------------------------------------------
# Required before the Ops UI can read or write secrets. Generate with:
#   openssl rand -hex 32
OPS_ADMIN_TOKEN=change-me-before-anything-else

# -----------------------------------------------------------------------------
# 1. Exchange
# -----------------------------------------------------------------------------
# Pick one as active (ccxt id).
# ACTIVE_EXCHANGE=binance        # binance | coinbase | okx | cryptocom | independentreserve | moomoo

# Generic CCXT fallback (used when the active exchange has no dedicated slot).
# API_KEY=
# API_SECRET=

# Coinbase Advanced Trade
# COINBASE_API_KEY=
# COINBASE_API_SECRET=
# COINBASE_PASSPHRASE=           # only for legacy Pro API

# OKX
# OKX_API_KEY=
# OKX_API_SECRET=
# OKX_PASSPHRASE=

# Crypto.com Exchange
# CRYPTOCOM_API_KEY=
# CRYPTOCOM_API_SECRET=

# Independent Reserve
# INDEPENDENTRESERVE_API_KEY=
# INDEPENDENTRESERVE_API_SECRET=

# Moomoo (OpenD must be running locally)
# MOOMOO_HOST=127.0.0.1
# MOOMOO_PORT=11111
# MOOMOO_MARKET=HK               # HK | US | CN
# MOOMOO_TRADE_ENV=SIMULATE      # SIMULATE | REAL
# MOOMOO_ACCOUNT_ID=
# MOOMOO_TRADE_PASSWORD=         # plain; gets md5'd by the trader
# MOOMOO_TRADE_PWD_MD5=          # alternative: pre-hashed
# MOOMOO_RSA_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# 2. LLM / AI tooling
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_API_KEY=sk-ant-...      # alias for Anthropic; used by Claude Code / SDK
# GEMINI_API_KEY=...
# CODEX_API_KEY=sk-...           # OpenAI Codex / Codex CLI (falls back to OPENAI_API_KEY)

# -----------------------------------------------------------------------------
# 3. Market data
# -----------------------------------------------------------------------------
# COINGECKO_API_KEY=
# CRYPTOCOMPARE_API_KEY=
# CMC_API_KEY=
# GLASSNODE_API_KEY=
# NANSEN_API_KEY=
# DUNE_API_KEY=
# ARKHAM_API_KEY=
# HELIUS_API_KEY=
# ALCHEMY_API_KEY=

# -----------------------------------------------------------------------------
# 4. News / social
# -----------------------------------------------------------------------------
# NEWS_API_KEY=
# X_BEARER_TOKEN=
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=claw247-trading/0.1

# -----------------------------------------------------------------------------
# 5. Notifications (all optional)
# -----------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=123456:ABCDEF...
# TELEGRAM_CHAT_ID=

# -----------------------------------------------------------------------------
# 6. Infrastructure
# -----------------------------------------------------------------------------
# ENCRYPTION_KEY=               # required for core.security at-rest crypto
# TRADE_DB_PATH=trades.db
# OPENCLAW_AUDIT_JSONL=logs/openclaw.jsonl

# -----------------------------------------------------------------------------
# 7. Modes / feature flags
# -----------------------------------------------------------------------------
CLAW_MODE=paper                 # paper | live
CLAW_VERSION=dev
CLAW_CORS_ORIGINS=*
CLAW_GATE_THRESHOLD=0.75

# Opt-in for OpenClaw operator layer (Phase 4 attach):
# OPENCLAW_ORCHESTRATOR=1
# OPENCLAW_DAYTRADE=1
# OPENCLAW_LIVE_TRADING=1       # required alongside live mode + policy

# ═══════════════════════════════════════════════════════════════════════
# SPOT AGGRO telemetry (Phase 11) — QuestDB + Grafana + Sentry
# ═══════════════════════════════════════════════════════════════════════
# Defaults assume local Docker stack from conf/docker-compose.telemetry.yml.
# Telemetry is non-blocking: if QuestDB is down, emits silently drop.

SPOT_TELEMETRY_ENABLED=1
SPOT_QUESTDB_HOST=127.0.0.1
SPOT_QUESTDB_ILP_PORT=9009           # ILP ingest (engine writes here)
SPOT_QUESTDB_PG_PORT=8812            # PostgreSQL wire (Grafana reads here)
SPOT_TELEMETRY_QUEUE=8192
SPOT_TELEMETRY_STOP_TIMEOUT_S=2.0
SPOT_TELEMETRY_CONNECT_TIMEOUT_S=2.0
SPOT_TELEMETRY_SEND_TIMEOUT_S=1.5

# Sentry — DORMANT UNTIL DSN IS SET. Leave blank to disable.
# Create a Sentry project (name: spot_aggro), copy both DSNs in.
SPOT_SENTRY_BACKEND_DSN=
SPOT_SENTRY_FRONTEND_DSN=
SPOT_SENTRY_ENV=production
SPOT_SENTRY_RELEASE=dev
SPOT_SENTRY_TRACES=0.05
