--- a/services/risk_manager.py
+++ b/services/risk_manager.py
@@ -1,3 +1,4 @@
+# === SPOT EXTENSIONS — added caps for spot pre-spike strategy ===
 # Append to RiskManager class config defaults:
+
+    SPOT_DEFAULTS = {
+        "spot_max_notional_pct": 25.0,
+        "spot_max_concurrent_positions": 3,
+        "spot_per_trade_pct": 1.50,
+        "spot_min_trade_quote": 25.0,
+        "spot_daily_loss_circuit_pct": 2.50,
+        "spot_max_holding_hours": 24,
+    }
+
+    def _validate_spot(self, intent) -> dict:
+        if intent.get("venue") != "okx_spot":
+            return {"approved": True}
+        size = float(intent.get("size_quote", 0))
+        eq = self.portfolio.equity_quote()
+        if size < self._cfg.get("spot_min_trade_quote", 25.0):
+            return {"approved": False, "reason": "below_min_trade"}
+        per_trade_cap = eq * (self._cfg.get("spot_per_trade_pct", 1.5) / 100.0)
+        if size > per_trade_cap:
+            return {"approved": False, "reason": "exceeds_per_trade_cap",
+                    "adjusted_size": per_trade_cap}
+        notional_now = self.portfolio.spot_notional()
+        max_notional = eq * (self._cfg.get("spot_max_notional_pct", 25.0) / 100.0)
+        if notional_now + size > max_notional:
+            return {"approved": False, "reason": "exceeds_total_spot_notional"}
+        n_open = self.portfolio.spot_open_count()
+        if n_open >= self._cfg.get("spot_max_concurrent_positions", 3):
+            return {"approved": False, "reason": "max_concurrent_spot_positions"}
+        return {"approved": True}
