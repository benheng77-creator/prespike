--- a/services/okx_client.py
+++ b/services/okx_client.py
@@ -1,3 +1,5 @@
+# === SPOT EXTENSIONS (additive — no perp methods modified) ===
+
 # Append these methods to OKXClient class:
+
+    async def spot_get_balance(self, ccy: str) -> float:
+        """Available balance in ccy on spot account."""
+        resp = await self._request("GET", "/api/v5/account/balance", {"ccy": ccy})
+        for item in resp.get("data", [{}])[0].get("details", []):
+            if item.get("ccy") == ccy:
+                return float(item.get("availBal", 0))
+        return 0.0
+
+    async def spot_get_book_top(self, instId: str) -> dict:
+        resp = await self._request("GET", "/api/v5/market/books",
+                                    {"instId": instId, "sz": "1"})
+        d = resp.get("data", [{}])[0]
+        return {
+            "bid": float(d.get("bids", [[0, 0]])[0][0]) if d.get("bids") else 0.0,
+            "ask": float(d.get("asks", [[0, 0]])[0][0]) if d.get("asks") else 0.0,
+        }
+
+    def spot_get_book_top_sync(self, instId: str) -> dict:
+        """Sync wrapper — uses cached websocket top-of-book."""
+        return self._top_of_book_cache.get(instId, {"bid": 0.0, "ask": 0.0})
+
+    async def spot_place_order(self, instId, side, ordType, sz, px=None, clOrdId=None):
+        body = {"instId": instId, "tdMode": "cash", "side": side,
+                "ordType": ordType, "sz": str(sz)}
+        if px is not None: body["px"] = str(px)
+        if clOrdId: body["clOrdId"] = clOrdId
+        resp = await self._request("POST", "/api/v5/trade/order", body)
+        d = resp.get("data", [{}])[0]
+        if d.get("sCode") not in ("0", 0):
+            return {"status": "rejected_post_only" if "post" in d.get("sMsg", "").lower()
+                    else "rejected", "reason": d.get("sMsg", "unknown")}
+        return {"status": "placed", "ord_id": d.get("ordId"), "client_oid": clOrdId}
+
+    async def spot_query_order(self, instId, clOrdId):
+        resp = await self._request("GET", "/api/v5/trade/order",
+                                    {"instId": instId, "clOrdId": clOrdId})
+        d = resp.get("data", [{}])[0]
+        state = d.get("state", "live")
+        return {
+            "state": state,
+            "avg_price": float(d.get("avgPx", 0) or 0),
+            "filled_qty": float(d.get("accFillSz", 0) or 0),
+            "fees": float(d.get("fee", 0) or 0),
+            "ord_id": d.get("ordId"),
+        }
+
+    async def spot_cancel_order(self, instId, ordId):
+        await self._request("POST", "/api/v5/trade/cancel-order",
+                             {"instId": instId, "ordId": ordId})
